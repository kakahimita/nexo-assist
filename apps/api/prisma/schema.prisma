generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model SystemMetadata {
  key   String @id
  value String
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  role String
  sessions Session[]
  conversations Conversation[]
  tickets Ticket[]
  ticketDrafts TicketDraft[]
  draftProposalRuns DraftProposalRun[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  authoredMessages Message[] @relation("MessageAuthor")
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  expiresAt DateTime
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  state String @default("agent")
  stateVersion Int @default(0)
  handoffReason String?
  handoffSummary String?
  handoffRequestedAt DateTime?
  assignedAnalystId String?
  assignedAnalyst User? @relation("AssignedConversations", fields: [assignedAnalystId], references: [id])
  closedAt DateTime?
  messages Message[]
  draftProposalRuns DraftProposalRun[]
}

model Message {
  id String @id @default(cuid())
  content String
  role String @default("employee")
  status String @default("completed")
  decision AgentDecision?
  authorId String?
  author User? @relation("MessageAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  title String
  normalizedTitle String
  description String
  type String
  category String
  priority String
  impact String
  status String @default("open")
  transferRequested Boolean @default(false)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  slaStartedAt DateTime
  events TicketEvent[]
  @@index([ownerId])
}

model TicketEvent {
  id String @id @default(cuid())
  ticketId String
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind String
  content String
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}

model TicketDraft {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  version Int @default(1)
  status String @default("pending")
  versions TicketDraftVersion[]
  operations TicketOperation[]
  proposalRun DraftProposalRun?
  @@index([ownerId])
}

model DraftProposalRun {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  draftId String @unique
  draft TicketDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@index([ownerId, conversationId])
}

model TicketDraftVersion {
  id String @id @default(cuid())
  draftId String
  draft TicketDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  version Int
  operationId String @unique
  inputJson String
  priority String?
  @@unique([draftId, version])
}

model TicketOperation {
  operationId String @id
  ownerId String
  draftId String
  draft TicketDraft @relation(fields: [draftId], references: [id])
  version Int
  fingerprint String
  resultJson String
  createdAt DateTime @default(now())
  @@index([draftId])
}

model KnowledgeArticle {
  id String @id
  title String
  summary String
  body String
  category String
  platform String
  keywords String
  createdAt DateTime @default(now())
}

model AgentDecision {
  id String @id @default(cuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  intent String
  action String
  appliedRule String
  confidence Float
  justification String
  missingFactsJson String
  quickRepliesJson String
  actionsJson String
  evidenceJson String
  ticketsJson String
  outcome String
  errorCode String?
  source String
  promptVersion String
  draftId String?
  createdAt DateTime @default(now())
  @@index([messageId])
}
