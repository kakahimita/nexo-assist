{
  "name": "@nexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:init": "npm run db:generate && prisma migrate deploy && tsx src/database/initialize.ts",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nexo/contracts": "*",
    "@nestjs/common": "11.2.8",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
