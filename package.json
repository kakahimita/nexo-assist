{
  "name": "nexo-assist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @nexo/contracts",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && npm run typecheck --workspace @nexo/contracts",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build --workspace @nexo/contracts && vitest run --project unit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
